# Copy to .env and fill in. Never commit .env.

# Database: leave empty to use local SQLite (data/news_digest.db).
# PostgreSQL example: postgresql+psycopg2://digest:change-me@localhost:5432/news_digest
DATABASE_URL=

# Used by docker-compose for the bundled PostgreSQL container
POSTGRES_USER=digest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news_digest

# OpenAI (optional). Without a key the app uses a local extractive summariser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ingestion
FETCH_FULL_ARTICLES=false
REQUEST_TIMEOUT=10
MAX_ARTICLES_PER_FEED=20

# Email (optional). Without SMTP settings digests are stored as previews.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=digest@example.com
